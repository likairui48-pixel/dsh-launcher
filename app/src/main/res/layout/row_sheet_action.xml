<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/s_xl"
    android:paddingRight="@dimen/s_xl"
    android:paddingTop="@dimen/s_m"
    android:paddingBottom="@dimen/s_m">

    <com.dsh.launcher.ui.GlyphView
        android:id="@+id/actionGlyph"
        android:layout_width="@dimen/icon_m"
        android:layout_height="@dimen/icon_m"
        android:importantForAccessibility="no"
        app:glyph="file"
        app:glyphStroke="1.9dp"
        app:glyphTint="@color/textSecondary" />

    <TextView
        android:id="@+id/actionLabel"
        style="@style/Dsh.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/s_m"
        android:layout_weight="1"
        android:maxLines="2" />
</LinearLayout>
